{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/(build/.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(images/.*|img/.*|css/.*|js/.*|favicon\\.ico|favicon\\.png)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.(?:png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|mp3|mp4|ico|css|js))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}